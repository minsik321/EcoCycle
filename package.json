{
  "name": "ecocycle",
  "private": true,
  "version": "0.0.0",
  "description": "EcoCycle 스마트 폐지 처리 대시보드",
  "workspaces": [
    "shared",
    "mock-server",
    "app"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n mock,app -c blue,green \"npm run mock\" \"npm run dev:app\"",
    "dev:app": "npm run dev -w @ecocycle/app",
    "mock": "npm run dev -w @ecocycle/mock-server --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @ecocycle/app",
    "test:text": "npm run test:text -w @ecocycle/app",
    "build": "npm run build -w @ecocycle/app",
    "measure:load": "npm run measure:load -w @ecocycle/app",
    "poster": "npm run poster -w @ecocycle/app"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
